# Server
PORT=3000
NODE_ENV=development

# Uploads
MAX_FILE_SIZE=100MB
UPLOAD_DIR=./uploads

# Reverse geocoding (optional). Leave REVERSE_GEOCODING_PROVIDER empty or
# "none" to disable reverse geocoding entirely.
#
# Supported providers:
#   nominatim  - OpenStreetMap Nominatim, no API key required (be mindful of
#                their usage policy: https://operations.osmfoundation.org/policies/nominatim/)
#   opencage   - https://opencagedata.com, requires REVERSE_GEOCODING_API_KEY
REVERSE_GEOCODING_PROVIDER=
REVERSE_GEOCODING_API_KEY=
# Optional contact info sent as part of the Nominatim User-Agent header, as
# required by their usage policy.
REVERSE_GEOCODING_CONTACT=

# Security
RATE_LIMIT_PER_MINUTE=20
CORS_ALLOWED_ORIGIN=*
